# The exact partner reservation form URL for this restaurant
YANDEX_FORM_URL=https://reservation.yandex.ru/partner-reserve/forms/7ff56a8f-5b24-4412-818f-c2ca20559c6f

# Where the browser's persistent profile (cookies, local storage) is stored.
# Reusing the same profile across runs is what keeps this session "warm" instead
# of looking like a brand new anonymous visitor on every booking.
PROFILE_DIR=./.profile

# "false" runs a headed browser on a virtual display, which is what makes the
# noVNC live view possible. Production uses false (see LIVE_VIEW_URL below).
HEADLESS=true

# The RESTAURANT's timezone, not Moscow. Kaliningrad is UTC+2, one hour behind
# mainland Russia. Page JS serialises the chosen slot using the browser clock,
# so a mismatch shifts every submitted booking by an hour.
RESTAURANT_TIMEZONE=Europe/Kaliningrad

# The Yandex PARTNER PANEL displays times one hour ahead of what's submitted,
# regardless of browser timezone (confirmed: our browser resolves correctly to
# Europe/Kaliningrad and the panel still showed +1h). We compensate by clicking
# the slot one hour earlier so the panel reads correctly.
#
# CAVEAT, unresolved: this is the same widget real guests use. If Yandex sends
# the guest any confirmation off the submitted value, they'd see the shifted
# (wrong) time while staff see the right one. Nobody has confirmed whether such
# a notification exists. Set to 0 to disable if Yandex clarifies.
PANEL_TIME_OFFSET_MINUTES=-60

# Telegram bot used to alert a human when a booking needs manual completion.
# Create a bot via @BotFather, then message it once and use
# https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum/maximum random delay (ms) enforced between consecutive booking
# attempts, so requests don't fire back to back like a bot would.
RESERVE_MIN_DELAY_MS=5000
RESERVE_MAX_DELAY_MS=12000

# How long to wait for either a success confirmation or a CAPTCHA to appear
# after submitting the form, before giving up and alerting a human anyway.
RESERVE_TIMEOUT_MS=60000

PORT=3100

# Shared secret the caller (n8n / ElevenLabs tool) sends as the x-api-key header.
# The server refuses requests if this is empty (unless ALLOW_NO_AUTH=true, local dev only).
API_KEY=

# The form requires an e-mail. Used when the caller doesn't send one.
DEFAULT_EMAIL=

# Jev (TypeSafe) decision layer: picks the right element when known selectors
# stop matching, gates the final submit click, and classifies the outcome screen.
# Without a key the service still runs on its known selectors.
TYPESAFE_API_KEY=
# How long to wait for a Jev response before falling back to known selectors
# alone (ms). Raised from the original 8000 after real-world calls from a
# Russian server took longer than that.
JEV_TIMEOUT_MS=20000
# Minimum Jev "form is complete" score before the submit click. 0.55 keeps
# margin above wrong-fill scores (observed 0.05-0.48) without rejecting
# legitimate fills (observed as low as 0.62 in real runs, despite an early
# 2-sample calibration suggesting 0.75 was safe -- it wasn't).
SUBMIT_MIN_CONF=0.55

# 2captcha: interim CAPTCHA auto-solve, per Yandex's own recommendation as a
# bridge until their partner API ships (expected end of year). Tried first on
# any CAPTCHA; if it fails, falls through to the existing Telegram + live-view
# human handoff automatically. Leave empty to skip straight to that handoff.
TWOCAPTCHA_API_KEY=
# Total time budget across all retries before falling back to the human
# handoff (ms). This gives delayed 2captcha workers more time while keeping
# the automatic wait bounded before Telegram/manual fallback.
TWOCAPTCHA_MAX_TOTAL_MS=120000
# Per-solve wait before giving up on that one attempt (ms), capped by
# whatever's left of TWOCAPTCHA_MAX_TOTAL_MS.
TWOCAPTCHA_SOLVE_TIMEOUT_MS=60000
# THE single most important setting for solve quality. These challenges are
# Cyrillic words; the default English-speaking worker pool returned 1-7
# character garbage for ~18-character Russian text and frequently reported
# "unsolvable". Switching to "rn" produced 16-18 character answers and solved
# a full 3-challenge chain on the first try. Do not change this to "en".
TWOCAPTCHA_LANGUAGE_POOL=rn
# One-time diagnostic only (captures the CAPTCHA's real markup to a log line
# the first time one appears) -- safe to leave on, but not needed anymore now
# that the real widget (Yandex SmartCaptcha, image+text) has been confirmed.
CAPTCHA_DIAGNOSTIC=false

# SAFETY: while true the form is filled and verified but never submitted.
# Set to false only after a supervised test booking has confirmed the success screen.
DRY_RUN=true

# Live view for CAPTCHA handoff (needs HEADLESS=false + VNC_PASSWORD, see Dockerfile).
# Public HTTPS URL of the noVNC page; it's added to the Telegram alert.
LIVE_VIEW_URL=
VNC_PASSWORD=
HANDOFF_WAIT_MS=600000

# Where decisions.log, the selector cache and the browser profile live.
# In Docker this is /data inside a named volume -- NOT a host path. Reach it
# with: docker compose exec reserve ls /data
DATA_DIR=./data

# Keeps the success-screen screenshot instead of deleting it after sending.
# Only for calibrating the success detector; screenshots contain guest data.
DEBUG_SHOTS=false
